#!/bin/zsh
set -u

script_dir=${0:A:h}
hub_root=${script_dir:h}
manifest=${hub_root}/sources.json
profile_name=""
no_input=0
replace=0

typeset -i created=0 retained=0 reconciled=0 conflicts=0 skipped=0 restored=0

usage() {
  print "Usage: ./scripts/bootstrap --profile <name> [--no-input] [--replace]"
}

die_preflight() {
  print -u2 "PREFLIGHT FAILED: $1"
  exit 2
}

while (( $# )); do
  case $1 in
    --profile) profile_name=${2:-}; shift 2 ;;
    --no-input) no_input=1; shift ;;
    --replace) replace=1; shift ;;
    -h|--help) usage; exit 0 ;;
    *) usage; exit 2 ;;
  esac
done

[[ -n $profile_name ]] || { usage; exit 2; }
profile=${hub_root}/profiles/${profile_name}.json

for command in git plutil; do
  command -v "$command" >/dev/null 2>&1 || die_preflight "install $command, then rerun ./scripts/bootstrap --profile $profile_name"
done
[[ $(uname) == Darwin ]] || die_preflight "v1 supports macOS/zsh only"
[[ -n ${ZSH_VERSION:-} ]] || die_preflight "run this script with zsh"
[[ -f $manifest ]] || die_preflight "missing sources.json"
[[ -f $profile ]] || die_preflight "unknown profile: $profile_name"
plutil -convert xml1 -o /dev/null "$manifest" >/dev/null 2>&1 || die_preflight "sources.json is not valid JSON"
plutil -convert xml1 -o /dev/null "$profile" >/dev/null 2>&1 || die_preflight "profile is not valid JSON"
[[ $(plutil -extract schema_version raw -o - "$manifest") == 1 ]] || die_preflight "unsupported sources.json schema"
[[ $(plutil -extract schema_version raw -o - "$profile") == 1 ]] || die_preflight "unsupported profile schema"

resolve_destination() {
  case $1 in
    agents) print "${AGENTS_HOME:-$HOME/.agents}/skills" ;;
    claude) print "${CLAUDE_HOME:-$HOME/.claude}/skills" ;;
    codex) print "${CODEX_HOME:-$HOME/.codex}/skills" ;;
    *) return 1 ;;
  esac
}

typeset -a destinations skills source_ids
# Profile identifiers are intentionally constrained to simple, whitespace-free names.
# Keep array decoding dependency-free while retaining plutil as the JSON parser.
array_values() {
  plutil -extract "$2" json -o - "$1" | tr -d '[]" ' | tr ',' '\n'
}
destinations=("${(@f)$(array_values "$profile" destinations)}")
skills=("${(@f)$(array_values "$profile" skills)}")
(( ${#destinations} > 0 && ${#skills} > 0 )) || die_preflight "profile must declare destinations and skills"

for destination_name in $destinations; do
  destination=$(resolve_destination "$destination_name") || die_preflight "unknown destination: $destination_name"
  parent=${destination:h}
  while [[ ! -e $parent && $parent != / ]]; do parent=${parent:h}; done
  [[ -d $parent && -w $parent ]] || die_preflight "destination parent is not writable: $parent"
done

source_ids=("${(@f)$(plutil -extract sources xml1 -o - "$manifest" | sed -n $'s/^\\t<key>\\([^<]*\\)<\\/key>$/\\1/p')}")
(( ${#source_ids} > 0 )) || die_preflight "manifest has no sources"

valid_skill_path() {
  local skill_id=$1 source_id mapped_path
  if [[ -f ${hub_root}/skills/${skill_id}/SKILL.md ]]; then
    print "${hub_root}/skills/${skill_id}"
    return 0
  fi
  for source_id in $source_ids; do
    mapped_path=$(sed -n "s/.*\"${skill_id}\"[[:space:]]*:[[:space:]]*\"\\([^\"]*\\)\".*/\\1/p" "$manifest")
    [[ -n $mapped_path ]] || continue
    [[ $mapped_path != /* && $mapped_path != *".."* && -f ${hub_root}/sources/${source_id}/${mapped_path}/SKILL.md ]] || continue
    print "${hub_root}/sources/${source_id}/${mapped_path}"
    return 0
  done
  return 1
}

mkdir -p "${hub_root}/sources" "${hub_root}/.hub-state" || die_preflight "cannot create Hub state directories"
for source_id in $source_ids; do
  url=$(plutil -extract "sources.${source_id}.url" raw -o - "$manifest") || { (( skipped++ )); continue; }
  revision=$(plutil -extract "sources.${source_id}.revision" raw -o - "$manifest") || { (( skipped++ )); continue; }
  license_path=$(plutil -extract "sources.${source_id}.license_path" raw -o - "$manifest") || { (( skipped++ )); continue; }
  checkout=${hub_root}/sources/${source_id}
  if [[ -d $checkout/.git ]]; then
    git -C "$checkout" remote get-url origin >/dev/null 2>&1 || { print -u2 "SKIP source $source_id: not a Git checkout"; (( skipped++ )); continue; }
    git -C "$checkout" fetch --quiet origin "$revision" || { print -u2 "SKIP source $source_id: cannot fetch pin"; (( skipped++ )); continue; }
  elif [[ -e $checkout ]]; then
    print -u2 "SKIP source $source_id: checkout path is occupied"
    (( skipped++ )); continue
  else
    git clone --quiet "$url" "$checkout" || { print -u2 "SKIP source $source_id: clone failed"; (( skipped++ )); continue; }
    git -C "$checkout" fetch --quiet origin "$revision" || { print -u2 "SKIP source $source_id: cannot fetch pin"; (( skipped++ )); continue; }
  fi
  git -C "$checkout" checkout --quiet --detach "$revision" || { print -u2 "SKIP source $source_id: cannot restore pin"; (( skipped++ )); continue; }
  [[ $(git -C "$checkout" rev-parse HEAD) == "$revision" && -f "$checkout/$license_path" ]] || { print -u2 "SKIP source $source_id: pin or license evidence failed"; (( skipped++ )); continue; }
  (( restored++ ))
done

for destination_name in $destinations; do
  destination=$(resolve_destination "$destination_name")
  state=${hub_root}/.hub-state/${profile_name}-${destination_name}.tsv
  mkdir -p "$destination"
  touch "$state"
  previous_state=$(mktemp "${TMPDIR:-/tmp}/skills-hub-state.XXXXXX")
  cp "$state" "$previous_state"
  typeset -A selected
  for skill_id in $skills; do selected[$skill_id]=1; done
  while IFS=$'\t' read -r stale_id stale_target; do
    [[ -n ${selected[$stale_id]:-} ]] && continue
    stale_link=${destination}/${stale_id}
    if [[ -L $stale_link && $(readlink "$stale_link") == "$stale_target" ]]; then
      rm "$stale_link"; (( reconciled++ ))
    fi
  done < "$previous_state"
  : > "$state"
  for skill_id in $skills; do
    target=$(valid_skill_path "$skill_id") || { print -u2 "SKIP $profile_name/$destination_name/$skill_id: missing or invalid selection"; (( skipped++ )); continue; }
    link=${destination}/${skill_id}
    if [[ -L $link && $(readlink "$link") == "$target" ]]; then
      (( retained++ ))
    elif [[ ! -e $link ]]; then
      ln -s "$target" "$link" || { (( skipped++ )); continue; }
      (( created++ ))
    elif (( replace )) && [[ -L $link ]]; then
      recorded_target=$(awk -F $'\t' -v id="$skill_id" '$1 == id { print $2; exit }' "$previous_state")
      if [[ -n $recorded_target && $(readlink "$link") == "$recorded_target" ]]; then
        rm "$link" && ln -s "$target" "$link" && (( created++ ))
      else
        print -u2 "CONFLICT $profile_name/$destination_name/$skill_id: existing target left untouched"
        (( conflicts++ ))
        continue
      fi
    else
      print -u2 "CONFLICT $profile_name/$destination_name/$skill_id: existing target left untouched"
      (( conflicts++ ))
      continue
    fi
    print -r -- "${skill_id}"$'\t'"${target}" >> "$state"
  done
  rm -f "$previous_state"
done

if (( skipped || conflicts )); then
  print "INCOMPLETE profile=$profile_name sources=$restored created=$created retained=$retained reconciled=$reconciled conflicts=$conflicts skipped=$skipped"
  print -u2 "Remediate the reported items, then rerun ./scripts/bootstrap --profile $profile_name"
  exit 1
fi
print "COMPLETE profile=$profile_name sources=$restored created=$created retained=$retained reconciled=$reconciled conflicts=0 skipped=0"
